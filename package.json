{
  "name": "william-magpie",
  "version": "1.0.1",
  "description": "Magpie 坚果云账号凭证无感自动同步插件 (支持 Windows & macOS 双向免登录)",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "page",
    "index.mjs",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "magpie-page"
  ],
  "author": "995william",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/995william/william-magpie.git"
  },
  "magpie": {
    "name": "坚果云免登同步",
    "description": "多台电脑只要在一台登录，自动通过坚果云加密同步到其他电脑（支持 Claude Code、Codex 等），无感免重新扫码登录。",
    "page": {
      "title": "免登同步",
      "titles": {
        "zh": "免登同步",
        "zh-TW": "免登同步",
        "en": "Auth Sync"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [],
    "options": {
      "autoPush": true,
      "autoPull": true,
      "interval": 5
    }
  }
}
